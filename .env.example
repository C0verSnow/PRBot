# Settings > Configuration saves these fields explicitly in the selected private .env.
# Process environment variables take priority. Blank Client Secret keeps the saved value.
# Bootstrap only. Operational settings and secrets are read from Infisical.
INFISICAL_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
