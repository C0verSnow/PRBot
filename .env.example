# 软件选择工作路径后，在生成的 PRBot-workspaces 目录内填写 .env。
# 软件自动生成权限为 600 的 .env 和本示例；保存后重启 PRBot。
# 一行一个 KEY=value；可用成对引号，不支持变量展开或行尾注释。
# 留空表示沿用钥匙串或界面设置。不要把真实 .env 提交到 Git。

# 只使用 /id：填写 BotFather 提供的 Token。
TELEGRAM_BOT_TOKEN=

# 使用 /FinishIssue 还需以下三项。
# GitHub Token：目标仓库 Contents / Pull requests / Issues 写权限，Actions / Checks 读权限。
GITHUB_TOKEN=
# 通过 /id 获取自己的数字 ID；多个值以英文逗号分隔。
PRBOT_ALLOWED_USERS=
# 仓库格式 owner/repo；多个值以英文逗号分隔。
PRBOT_ALLOWED_REPOS=

# Codex 登录不写进 .env：先登录 Codex，再在 PRBot 选择“导入 Codex 登录”。
# 不需要填写 OPENAI_API_KEY；本功能复用 Codex 的 ChatGPT 登录。

# 可选设置；不填写则使用界面已保存值或软件默认值。
# 工作路径请在软件菜单选择，不在 .env 中更改。
# PRBOT_LOG_LEVEL=INFO
# PRBOT_POLL_TIMEOUT=30
# PRBOT_AUTOSTART=false
# PRBOT_SESSION_TTL=900
# PRBOT_TASK_TIMEOUT=1800
# PRBOT_TASK_CONCURRENCY=1
# PRBOT_CI_TIMEOUT=3600
# PRBOT_REQUIRED_CHECKS=test,dmg
